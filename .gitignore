# Dependencies
node_modules/
**/node_modules/

# Environment variables (never commit real secrets/keys)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Build output
dist/
build/
**/dist/
**/build/

# Uploaded/generated audio test files (kept locally only)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor files
.DS_Store
Thumbs.db
*.swp

# Editor
.vscode/*
!.vscode/settings.json

# All environment files except checked-in templates
.env.*
!.env.example
# Local provider credentials and recordings
*.pem
*.p12
*.pfx
*service-account*.json
*firebase-adminsdk*.json
*.wav
*.mp3
*.m4a
